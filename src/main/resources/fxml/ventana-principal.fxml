<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="350.0" spacing="25.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <!-- Título actualizado y centrado -->
      <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="OmniTaller" />

      <!-- Contenedor interno para los botones con espaciado uniforme -->
      <VBox alignment="CENTER" spacing="12.0" VBox.vgrow="ALWAYS">
         <children>
            
            <!-- Acción Principal (Call to action en azul) -->
            <Button fx:id="RnCita" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegistrarCita" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px; -fx-background-radius: 5px; -fx-font-size: 14px;" text="Registrar nueva cita" />

            <!-- Menú de navegación (Botones secundarios en blanco con borde sutil) -->
            
            <!-- NUEVO BOTÓN PARA EL INVENTARIO (HU-12) -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegistarCotizacion" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Registrar Cotización" />

            <!-- NUEVO BOTÓN PARA CITAS AGENDADAS (HU-01) -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCitasAgendadas" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Citas agendadas" />

            <!-- NUEVO BOTÓN PARA LA REPARACION (HU-06) SPRINT 1 -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegistrarReparacion" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Registrar Reparacion" />

            <!-- NUEVO BOTÓN PARA LISTA VEHICULOS ENTREGA (HU-42) -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleVehiculosEntrega" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Vehículos por Entregar" />

            <!-- NUEVO BOTÓN PARA EL INVENTARIO (HU-14) -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleConsultarInventario" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Consultar Inventario" />

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegistrarPieza" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Registrar pieza" />

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleConsultarDistribuidores" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Consultar distribuidores" />

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegistrarServicio" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Historial de servicio" />

            <!-- Nuevo botón para la ventana de pedidos (HU-30) -->
            <Button fx:id="btnPedidos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirVentanaPedidos" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Gestión de Pedidos" />
            
            <!-- INICIO Modificación realizada por Erik para la HU-34 (Notificación de Atraso) -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleInformeAtrasos" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 12px; -fx-font-size: 14px;" text="Informe de Atrasos" />
            <!-- FIN Modificación Erik HU-34 -->
            
         </children>
      </VBox>
   </children>
</VBox>